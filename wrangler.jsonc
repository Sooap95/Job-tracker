{
  "name": "job-tracker-private",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "ALLOWED_GITHUB_USER_ID": "152836698",
    "DATA_BRANCH": "main",
    "DATA_PATH": "data/jobs-v2.json",
    "DATA_REPO": "Sooap95/job-tracker-data",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23lifHSng6jdVx5xdb"
  }
}
